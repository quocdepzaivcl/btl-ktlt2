{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build FTTH project (C++17)",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-Iinclude",
                "src/main.cpp",
                "src/Application.cpp",
                "src/use_cases/UC1_Customers.cpp",
                "src/use_cases/UC2_Registrations.cpp",
                "src/use_cases/UC3_Plans.cpp",
                "src/use_cases/UC4_PlanChanges.cpp",
                "src/use_cases/UC5_Contracts.cpp",
                "src/use_cases/UC6_Renewals.cpp",
                "src/use_cases/UC7_Payments.cpp",
                "src/use_cases/UC8_Invoices.cpp",
                "src/use_cases/UC9_Incidents.cpp",
                "src/use_cases/UC10_Supports.cpp",
                "-o",
                "${workspaceFolder}/bin/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Bien dich toan bo du an FTTH voi g++ (C++17)"
        }
    ]
}
